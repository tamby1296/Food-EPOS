# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Never commit the resulting `.env` file.

# --- Postgres ---
POSTGRES_USER=foodepos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=foodepos
POSTGRES_PORT=5432

# --- Backend (FoodEpos.API) ---
# Must be at least 32 characters; used to sign JWTs.
JWT_KEY=change_me_min_32_characters_long
JWT_EXPIRY_HOURS=8
ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5287

# --- Frontend (nginx) ---
FRONTEND_PORT=8080

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser

# Rider IDE
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
.history/

# Backup & report files
*.bak
*.tmp
*.log
*.vspscc
*.vssscc
*.ncb
*.opensdf
*.sdf
*.cachefile
*.dbmdl

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
*.trx

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet packages
*.nupkg
*.snupkg
# The packages folder can be ignored if you use package restore
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config

# Azure artifacts
*.azurePubxml
*.publishsettings
*.Publish.xml
*.pubxml
*.pubxml.user
*.azurePubxml
*.deployment
*.deploy.cmd

# Entity Framework
*.mdf
*.ldf

# Node modules (if using frontend build)
node_modules/

# Environment variables
.env
.env.*

# Compiled files
*.dll
*.exe
*.pdb

# Misc
*.orig
*.rej

# VS local web server settings
.vs/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/

# Mac files
.DS_Store

# Windows image file caches
Thumbs.db

# Publish output
/publish/
**/wwwroot/dist/
/wwwroot/node_modules/

# Tooling
/.tools/
/tools/

# Docker
*.dockerignore
docker-compose.override.yml
docker-compose.vs.debug.yml
docker-compose.vs.release.yml

# Coverage reports
coverage/
coverage*.json
coverage*.xml
lcov.info

# Temporary files
~$*
